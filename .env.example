# ─────────────────────────────────────────────────────────────────
# SMVShows – Environment Configuration Example
# Copy this file to .env and edit the values.
# ─────────────────────────────────────────────────────────────────

# Server
PORT=3000
LOG_LEVEL=info

# Deployment (public URL of your addon)
APP_HOST=

# ─── TMDB API (required) ─────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ─── Forum URLs (comma‑separated) ────────────────────────────────
# Series forums
SERIES_FORUM_URLS=

# Movie forums
MOVIE_FORUM_URLS=

# Dubbed movies (optional)
DUBBED_MOVIE_FORUM_URLS=

# Forum listing sort query (leave empty to use default)
FORUM_SORT_QUERY=&sortby=start_date&sortdirection=desc

# ─── Scraper Settings ────────────────────────────────────────────
SCRAPE_START_PAGE=1
SCRAPE_END_PAGE=1                     # increase for full crawl
SCRAPER_CONCURRENCY=2
SCRAPER_RETRY_COUNT=5
SCRAPER_TIMEOUT_SECS=30
SCRAPER_USER_AGENT=Mozila/5.0 (Linux; Android 14; SM-S928B/DS) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.6099.230 Mobile Safari/537.36

# ─── Proxy URLs (comma‑separated, optional) ─────────────────────
PROXY_URLS=

# ─── Scheduler ───────────────────────────────────────────────────
MAIN_WORKFLOW_CRON=15 * * * *

# ─── Tracker List ────────────────────────────────────────────────
TRACKER_URL=https://ngosang.github.io/trackerslist/trackers_best.txt

# ─── Database Maintenance ────────────────────────────────────────
DB_AUTO_VACUUM_ENABLED=true
DB_AUTO_VACUUM_CRON=0 3 * * *

# ─── Debrid Provider ─────────────────────────────────────────────
# Which debrid service to use: 'realdebrid' | 'torbox' | 'none'
DEBRID_SERVICE=realdebrid

# Real‑Debrid API key (optional if not using RD)
REALDEBRID_API_KEY=your_rd_api_key_here

# TorBox API key (optional if not using TorBox)
TORBOX_API_KEY=your_torbox_api_key_here

# TorBox – override maximum active torrents (optional)
# If not set, TorBox will queue downloads natively.
# TORBOX_MAX_ACTIVE_TORRENTS=3

# ─── Node Environment ────────────────────────────────────────────
NODE_ENV=production
